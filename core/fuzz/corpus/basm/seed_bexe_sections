; Seed of the bexe fuzz target: every kind of section the loader copies.
.global _start
.text
_start:
    adrp x1, value
    add x1, x1, :lo12:value
    ldr x2, [x1]
    adrp x3, counter
    add x3, x3, :lo12:counter
    str x2, [x3]
    bl helper
    hlt
.section "fast", "rx"
helper:
    add x0, x2, 1
    ret
.data
value:
    .word 41
.rodata
message:
    .ascii "seed"
.init_array
    .word helper
.section "tables", "r"
    .word 1, 2, 3
.section "stack", "rw", "nobits"
    .advance 64
.bss
counter:
    .advance 16
