; #include <"include.binc">
#include "../include/include.binc"

;*
	Start of file
*;
.global _start
.extern array

.text
_start:
		add	x2, xzr, 0
.scope
array:
		adrp	x1, array
		add	x1, x1, :lo12:array
.scend

		adrp	x2, array
		add	x2, x2, :lo12:array
		ldr	x2, [x2]

		adrp	x0, datalabel
		add	x0, x0, :lo12:datalabel
		ldr	x0, [x0, 4]

		bl 	func
		hlt

func:
		mul	x0, x0, x2
		ret

;*#macro	testmacro(arg1, arg2)
		add	x1, x2, arg1
		sub	x1, x3, arg2
#macend

#invoke	testmacro(50, 30)*;

.data
datalabel:
	.byte		0x01, 0x02, 0x03, 0x04
	.dbyte		0x1234, 0x5678
	.word		0x12345678,
	.dword		0x0123456789abcdef,

;*
	End of file
*;
