; Benchmark of loads and stores with an index register, and of branches that depend on the data
; (tools/bench.sh).
;
; Fills 4096 words with a linear congruential generator and sorts them (unsigned) by insertion
; sort: about a million moves of an element, so the branch that ends the inner loop is taken
; or not at random. The array is 4 pages of .bss. A last loop checks the result: x0 is the number
; of neighbours that are out of order (0) and x15 the sum of the elements.

.global _start

.bss
array:      .advance 16384

.text
_start:
                adrp    x1, array
                add     x1, x1, :lo12:array
                ldr     x13, =4096              ; number of elements

                ldr     x2, =1103515245
                ldr     x6, =12345              ; the seed
                mov     x5, 0
fill:           mul     x6, x6, x2
                add     x6, x6, 12345
                str     x6, [x1, x5, lsl 2]
                add     x5, x5, 1
                cmp     x5, x13
                b.ne    fill

                mov     x8, 1                   ; i
outer:          ldr     x9, [x1, x8, lsl 2]     ; the element to insert
                sub     x10, x8, 1              ; j
inner:          ldr     x11, [x1, x10, lsl 2]
                cmp     x11, x9
                b.ls    place                   ; a[j] <= the element
                add     x12, x10, 1
                str     x11, [x1, x12, lsl 2]   ; a[j + 1] = a[j]
                subs    x10, x10, 1
                b.pl    inner
place:          add     x12, x10, 1
                str     x9, [x1, x12, lsl 2]
                add     x8, x8, 1
                cmp     x8, x13
                b.ne    outer

                ; the check: x0 counts the neighbours that are out of order, x15 is the sum
                mov     x0, 0
                ldr     x15, [x1]
                add     x14, x15, 0
                mov     x8, 1
check:          ldr     x9, [x1, x8, lsl 2]
                add     x15, x15, x9
                cmp     x14, x9
                cinc    x0, x0, hi
                add     x14, x9, 0
                add     x8, x8, 1
                cmp     x8, x13
                b.ne    check
                hlt
